# BOT_TOKEN - получить у @BotFather в Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# OWNER_TELEGRAM_ID - ваш Telegram User ID (узнать у @userinfobot)
OWNER_TELEGRAM_ID=YOUR_TELEGRAM_ID_HERE

# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=dairy_user
DB_PASSWORD=your_secure_password
DB_NAME=dairy_of_life

# Timezone (default: Asia/Bangkok)
TIMEZONE=Asia/Bangkok

# Gemini Vision API Key (для распознавания еды по фото)
# Получить: https://makersuite.google.com/app/apikey
# Бесплатный лимит: 15 RPM, 1500 RPD
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Debug mode (True/False)
DEBUG=False
